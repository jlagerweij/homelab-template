# Copy to doco-cd/secrets.env, fill in, then encrypt:
#   cd apps && just encrypt ../doco-cd/secrets.env > ../doco-cd/secrets.enc.env && rm ../doco-cd/secrets.env
# Only commit secrets.enc.env.

# Key for doco-cd's REST API (used by the `just api-*` recipes). Generate with: openssl rand -hex 32
API_SECRET=
# GitHub personal access token with read access to this repository (needed when the repo is private)
GIT_ACCESS_TOKEN=
# Secret shared with the GitHub webhook that triggers deployments. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
