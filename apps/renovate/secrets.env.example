# Copy to apps/renovate/secrets.env, fill in, then encrypt:
#   cd apps && just encrypt renovate/secrets.env > renovate/secrets.enc.env && rm renovate/secrets.env
# Only commit secrets.enc.env.

# GitHub personal access token for this repository (fine-grained: Contents, Pull requests and Issues read/write)
RENOVATE_TOKEN=
# Optional: extra registry credentials as JSON, for example to avoid Docker Hub rate limits:
#   [{"hostType":"docker","matchHost":"docker.io","username":"YOUR_USER","password":"YOUR_TOKEN"}]
RENOVATE_HOST_RULES=
